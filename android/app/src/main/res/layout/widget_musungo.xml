<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/widget_connected_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/widget_title_button"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_device_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans"
                android:maxLines="1"
                android:textColor="#F4F7FB"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="82dp"
                    android:layout_height="82dp">

                    <ImageView
                        android:id="@+id/widget_left_ring"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Left battery ring" />

                    <ImageView
                        android:id="@+id/widget_left_bud"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="center"
                        android:contentDescription="Left earbud"
                        android:scaleType="centerInside" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/widget_left_battery_icon"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:contentDescription="Left battery" />

                    <TextView
                        android:id="@+id/widget_left_battery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="sans"
                        android:text="—"
                        android:textColor="#F4F7FB"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="82dp"
                    android:layout_height="82dp">

                    <ImageView
                        android:id="@+id/widget_right_ring"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Right battery ring" />

                    <ImageView
                        android:id="@+id/widget_right_bud"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="center"
                        android:contentDescription="Right earbud"
                        android:scaleType="centerInside" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/widget_right_battery_icon"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:contentDescription="Right battery" />

                    <TextView
                        android:id="@+id/widget_right_battery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="sans"
                        android:text="—"
                        android:textColor="#F4F7FB"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_noise_row"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="82dp"
                    android:layout_height="82dp"
                    android:background="@drawable/widget_noise_button_background">

                    <ImageView
                        android:id="@+id/widget_noise_mode_icon"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:contentDescription="Current noise control"
                        android:src="@drawable/widget_noise_mode_off" />
                </FrameLayout>

                <TextView
                    android:id="@+id/widget_noise_mode"
                    android:layout_width="82dp"
                    android:layout_height="28dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:fontFamily="sans"
                    android:text="Off"
                    android:textColor="#F4F7FB"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_skeleton_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/widget_skeleton_title"
            android:layout_width="112dp"
            android:layout_height="20dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/widget_metric_background" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="82dp"
                    android:layout_height="82dp"
                    android:background="@drawable/widget_ring_track" />

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/widget_metric_background" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="82dp"
                    android:layout_height="82dp"
                    android:background="@drawable/widget_ring_track" />

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/widget_metric_background" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="82dp"
                    android:layout_height="82dp"
                    android:background="@drawable/widget_ring_track" />

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="14dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/widget_metric_background" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
